# YouTube Data API v3 key (Google Cloud → APIs & Services → Credentials).
# Restrict it to "YouTube Data API v3". Don't add a website (referrer)
# restriction: the key is only used by the server.
YOUTUBE_API_KEY=

# Public address of the site, used for the sitemap and social previews.
SITE_URL=https://plainplay.vercel.app

# Optional: searches allowed per visitor every 10 minutes (default 30).
# SEARCH_RATE_LIMIT=30

# Optional: use built-in sample data instead of YouTube (tests and demos).
# Without a key, development uses sample data automatically.
# PLAINPLAY_SAMPLE_DATA=1
